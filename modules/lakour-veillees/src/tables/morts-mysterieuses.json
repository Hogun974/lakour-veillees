  "name": "Morts mystérieuses",
  "img": "icons/svg/d20-black.svg",
  "description": "<p>Récits de mort pour l'aube : trois phrases au plus. Adapte le lieu (« Maison 7 »), le nom, et retire tout détail qui livrerait la cause si elle doit rester secrète.</p>",
  "formula": "1d24",
  "replacement": true,
  "displayRoll": true,

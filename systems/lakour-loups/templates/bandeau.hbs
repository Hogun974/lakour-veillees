<div class="lb-corps phase-{{phase}} {{#if urgent}}lb-a-toi{{/if}}" role="toolbar" aria-label="{{localize 'LAKOUR_LOUPS.Bandeau.Titre'}}">
  <div class="lb-phase" title="{{phaseLibelle}}">
    <span class="lb-icone"><i class="fa-solid {{icone}}"></i></span>
    <span class="lb-phase-texte">
      <span class="lb-phase-nom">{{phaseLibelle}}</span>
      {{#if tour}}<span class="lb-tour">{{localize "LAKOUR_LOUPS.Table.Tour"}} {{tour}}</span>{{/if}}
    </span>
  </div>
  <span class="lb-minuteur" data-finit="{{finit}}" title="{{localize 'LAKOUR_LOUPS.Bandeau.TempsRestant'}}" hidden><i class="fa-solid fa-hourglass-half"></i> <span class="lb-reste" aria-live="off"></span></span>
  <div class="lb-action">
    {{#if annonce}}<span class="lb-annonce"><i class="fa-solid fa-star"></i> {{annonce}}</span>{{/if}}
    {{#if salon}}<span class="lb-salon {{salon.cle}}" title="{{salon.aide}}">{{salon.texte}}</span>{{/if}}
    {{#if statut}}<span class="lb-statut {{statut.cle}}"><i class="fa-solid {{statut.icone}}"></i> {{statut.texte}}</span>{{/if}}
    {{#if consigne}}<span class="lb-consigne">{{consigne}}</span>{{/if}}
    {{#if detail}}<span class="lb-detail">{{detail}}</span>{{/if}}
  </div>
  <div class="lb-boutons">
    {{#each pouvoirs}}
    <button type="button" class="lb-bouton {{#unless possible}}grise{{/unless}}" data-action="bandeauPouvoir" data-pouvoir="{{pouvoir}}" {{#unless possible}}aria-disabled="true" data-raison="{{raison}}"{{/unless}} {{#if aide}}data-tooltip="{{aide}}" data-tooltip-direction="DOWN"{{/if}}><i class="fa-solid {{icone}}"></i> {{libelle}}</button>
    {{/each}}
    {{#each boutons}}
    <button type="button" class="lb-bouton {{#if principal}}principal{{/if}}" data-action="{{action}}" data-tooltip="{{aide}}" data-tooltip-direction="DOWN" {{#if principal}}{{#unless @root.pret}}disabled{{/unless}}{{/if}}><i class="fa-solid {{icone}}"></i> {{libelle}}</button>
    {{/each}}
    {{#if monRole}}<button type="button" class="lb-bouton discret" data-action="bandeauRole" data-tooltip="{{localize 'LAKOUR_LOUPS.Bandeau.MonRoleAide'}}" data-tooltip-direction="DOWN"><i class="fa-solid fa-mask"></i> {{localize "LAKOUR_LOUPS.Bandeau.MonRole"}}</button>{{/if}}
    <button type="button" class="lb-bouton discret icone" data-action="bandeauTable" data-tooltip="{{localize 'LAKOUR_LOUPS.Table.Titre'}}" data-tooltip-direction="DOWN" aria-label="{{localize 'LAKOUR_LOUPS.Table.Titre'}}"><i class="fa-solid fa-fire-flame-curved"></i></button>
  </div>
</div>

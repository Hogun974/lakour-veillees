<div class="loups-fiche-corps">
  <header class="loups-fiche-tete {{#unless system.vivant}}mort{{/unless}} {{#if campCle}}camp-{{campCle}}{{/if}}">
    <div class="loups-fiche-cadre">
      <img class="loups-fiche-portrait" src="{{acteur.img}}" alt="{{acteur.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
      {{#unless system.vivant}}<span class="loups-fiche-sceau"><i class="fa-solid fa-cross"></i></span>{{/unless}}
    </div>
    <div class="loups-fiche-identite">
      {{#if editable}}<input class="loups-fiche-nom" type="text" name="name" value="{{acteur.name}}">{{else}}<h1 class="loups-fiche-nom">{{acteur.name}}</h1>{{/if}}
      <div class="loups-fiche-joueur"><i class="fa-solid fa-user"></i> {{joueurNom}}</div>

      <div class="loups-pilules">
        {{#if voitRole}}
          {{#if role}}
          <a class="loups-pilule role" data-action="ouvrirObjet" data-item-id="{{role.id}}" data-uuid="{{role.uuid}}" {{#if role.secret}}data-secret="1"{{/if}} {{#if role.bulle}}data-tooltip-html="{{role.bulle}}" data-tooltip-class="lakour-loups loups-bulle"{{/if}}>
            <span class="loups-pilule-cle"><i class="fa-solid fa-mask"></i> {{localize "LAKOUR_LOUPS.Fiche.Role"}}</span>
            <span class="loups-pilule-val"><img src="{{role.img}}" alt=""> {{role.nom}}</span>
          </a>
          {{else}}
          <span class="loups-pilule vide">
            <span class="loups-pilule-cle"><i class="fa-solid fa-mask"></i> {{localize "LAKOUR_LOUPS.Fiche.Role"}}</span>
            <span class="loups-pilule-val">—</span>
          </span>
          {{/if}}
          {{#if campLibelle}}
          <span class="loups-pilule camp camp-{{campCle}}">
            <span class="loups-pilule-cle"><i class="fa-solid fa-flag"></i> {{localize "LAKOUR_LOUPS.Fiche.CampActuel"}}</span>
            <span class="loups-pilule-val">{{campLibelle}}</span>
          </span>
          {{/if}}
        {{else}}
        <span class="loups-pilule cache" data-tooltip-text="{{localize 'LAKOUR_LOUPS.Fiche.RoleCache'}}">
          <span class="loups-pilule-cle"><i class="fa-solid fa-mask"></i> {{localize "LAKOUR_LOUPS.Fiche.Role"}}</span>
          <span class="loups-pilule-val"><i class="fa-solid fa-lock"></i></span>
        </span>
        {{/if}}
        {{#if metier}}
        <a class="loups-pilule metier" data-action="ouvrirObjet" data-item-id="{{metier.id}}" {{#if metier.bulle}}data-tooltip-html="{{metier.bulle}}" data-tooltip-class="lakour-loups loups-bulle"{{/if}}>
          <span class="loups-pilule-cle"><i class="fa-solid fa-hammer"></i> {{localize "LAKOUR_LOUPS.Fiche.Metier"}}</span>
          <span class="loups-pilule-val"><img src="{{metier.img}}" alt=""> {{metier.nom}}</span>
        </a>
        {{/if}}
        {{#if system.maison}}
        <span class="loups-pilule maison">
          <span class="loups-pilule-cle"><i class="fa-solid fa-door-closed"></i>{{#if maisonEtiquette}} {{localize "LAKOUR_LOUPS.Fiche.Maison"}}{{/if}}</span>
          <span class="loups-pilule-val">{{maisonLibelle}}</span>
        </span>
        {{/if}}
      </div>

      <div class="loups-insignes">
        {{#each etats}}<span class="loups-insigne {{classe}}" {{#if bulle}}data-tooltip-text="{{bulle}}"{{/if}}><i class="fa-solid {{icone}}"></i> {{texte}}</span>{{/each}}
      </div>
    </div>
  </header>

  <div class="loups-corps">
    <section class="loups-encart loups-atouts-encart">
      <h3><i class="fa-solid fa-wand-sparkles"></i> {{localize "LAKOUR_LOUPS.Fiche.Pouvoirs"}}</h3>
      <div class="loups-atouts">
        {{#if voitRole}}
          {{#if role}}
          <article class="loups-atout role {{#if campCle}}camp-{{campCle}}{{/if}}">
            <div class="loups-atout-tete" {{#if role.bulle}}data-tooltip-html="{{role.bulle}}" data-tooltip-class="lakour-loups loups-bulle"{{/if}}>
              <img class="loups-atout-icone" src="{{role.img}}" alt="" data-action="ouvrirObjet" data-item-id="{{role.id}}" data-uuid="{{role.uuid}}" {{#if role.secret}}data-secret="1"{{/if}}>
              <div class="loups-atout-titre">
                <div class="loups-atout-type"><i class="fa-solid fa-mask"></i> {{localize "LAKOUR_LOUPS.Fiche.Role"}}</div>
                <a class="loups-atout-nom" data-action="ouvrirObjet" data-item-id="{{role.id}}" data-uuid="{{role.uuid}}" {{#if role.secret}}data-secret="1"{{/if}}>{{role.nom}}</a>
              </div>
              {{#if role.usages}}
              <div class="loups-jauge" data-tooltip-text="{{localize 'LAKOUR_LOUPS.Role.UsagesRestant'}}">
                <div class="loups-jauge-jetons">{{#each role.jetons}}<span class="loups-jeton-usage {{#if plein}}plein{{/if}}"></span>{{/each}}</div>
                <small>{{role.usages}} {{localize "LAKOUR_LOUPS.Fiche.Usages"}}</small>
              </div>
              {{/if}}
              {{#if gm}}<button type="button" class="loups-icone" data-action="retirerObjet" data-item-id="{{role.id}}" data-uuid="{{role.uuid}}" {{#if role.secret}}data-secret="1"{{/if}} data-tooltip-text="{{localize 'LAKOUR_LOUPS.Fiche.Retirer'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
            </div>
            {{#unless system.revele}}<div class="loups-atout-secret"><i class="fa-solid fa-user-secret"></i> {{localize "LAKOUR_LOUPS.Fiche.Secret"}}</div>{{/unless}}
            <div class="loups-marques">
              {{#each role.rythme}}<span class="loups-marque {{classe}}"><i class="fa-solid {{icone}}"></i> {{texte}}</span>{{/each}}
              {{#if role.effet}}<span class="loups-marque effet" data-tooltip-text="{{localize 'LAKOUR_LOUPS.Role.Effet'}}"><i class="fa-solid fa-gears"></i> {{role.effet}}</span>{{/if}}
            </div>
            <details class="loups-atout-texte">
              <summary>{{localize "LAKOUR_LOUPS.Fiche.LireTexte"}}</summary>
              <div class="loups-texte">{{{role.description}}}</div>
              {{#if role.victoire}}<div class="loups-texte victoire"><strong>{{localize "LAKOUR_LOUPS.Role.Victoire"}}</strong>{{{role.victoire}}}</div>{{/if}}
            </details>
            {{#if prime}}<p class="loups-atout-ligne"><i class="fa-solid fa-crosshairs"></i> {{localize "LAKOUR_LOUPS.Fiche.Prime"}} <strong>{{prime}}</strong></p>{{/if}}
          </article>
          {{else}}
          <article class="loups-atout vide"><p class="loups-vide">{{localize "LAKOUR_LOUPS.Fiche.SansRole"}}</p></article>
          {{/if}}
        {{else}}
        <article class="loups-atout dos">
          <div class="loups-dos-embleme"><i class="fa-solid fa-lock"></i></div>
          <p class="loups-vide">{{localize "LAKOUR_LOUPS.Fiche.RoleCache"}}</p>
        </article>
        {{/if}}

        {{#if metier}}
        <article class="loups-atout metier">
          <div class="loups-atout-tete" {{#if metier.bulle}}data-tooltip-html="{{metier.bulle}}" data-tooltip-class="lakour-loups loups-bulle"{{/if}}>
            <img class="loups-atout-icone" src="{{metier.img}}" alt="" data-action="ouvrirObjet" data-item-id="{{metier.id}}">
            <div class="loups-atout-titre">
              <div class="loups-atout-type"><i class="fa-solid fa-hammer"></i> {{localize "LAKOUR_LOUPS.Fiche.Metier"}}</div>
              <a class="loups-atout-nom" data-action="ouvrirObjet" data-item-id="{{metier.id}}">{{metier.nom}}</a>
            </div>
            {{#if metier.usages}}
            <div class="loups-jauge" data-tooltip-text="{{localize 'LAKOUR_LOUPS.Role.UsagesRestant'}}">
              <div class="loups-jauge-jetons">{{#each metier.jetons}}<span class="loups-jeton-usage {{#if plein}}plein{{/if}}"></span>{{/each}}</div>
              <small>{{metier.usages}} {{localize "LAKOUR_LOUPS.Fiche.Usages"}}</small>
            </div>
            {{/if}}
            {{#if gm}}<button type="button" class="loups-icone" data-action="retirerObjet" data-item-id="{{metier.id}}" data-tooltip-text="{{localize 'LAKOUR_LOUPS.Fiche.Retirer'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
          </div>
          <div class="loups-marques">
            {{#each metier.rythme}}<span class="loups-marque {{classe}}"><i class="fa-solid {{icone}}"></i> {{texte}}</span>{{/each}}
            {{#if metier.effet}}<span class="loups-marque effet" data-tooltip-text="{{localize 'LAKOUR_LOUPS.Role.Effet'}}"><i class="fa-solid fa-gears"></i> {{metier.effet}}</span>{{/if}}
          </div>
          <details class="loups-atout-texte">
            <summary>{{localize "LAKOUR_LOUPS.Fiche.LireTexte"}}</summary>
            <div class="loups-texte">{{{metier.description}}}</div>
          </details>
        </article>
        {{else}}
        <article class="loups-atout vide"><p class="loups-vide">{{localize "LAKOUR_LOUPS.Fiche.SansMetier"}}</p></article>
        {{/if}}
      </div>
    </section>

    {{#if gm}}
    <section class="loups-encart loups-mj">
      <h3><i class="fa-solid fa-hat-wizard"></i> {{localize "LAKOUR_LOUPS.Fiche.Etat"}}</h3>
      <div class="loups-champs">
        <label>{{localize "LAKOUR_LOUPS.Fiche.Joueur"}} <select name="system.joueur">{{selectOptions joueurs selected=system.joueur}}</select></label>
        {{#if secret}}
        <label>{{localize "LAKOUR_LOUPS.Fiche.CampActuel"}} <select name="secret.camp">{{selectOptions camps selected=secret.camp}}</select></label>
        {{/if}}
        <label>{{localize "LAKOUR_LOUPS.Fiche.Maison"}} <input type="text" name="system.maison" value="{{system.maison}}"></label>
        {{#if secret}}
        <label>{{localize "LAKOUR_LOUPS.Fiche.Amoureux"}} <select name="secret.amoureux">{{selectOptions autres selected=secret.amoureux}}</select></label>
        <label>{{localize "LAKOUR_LOUPS.Fiche.Protections"}} <input type="number" name="secret.protections" value="{{secret.protections}}" min="0" step="1"></label>
        {{/if}}
        <label class="case"><input type="checkbox" name="system.vivant" {{checked system.vivant}}> {{localize "LAKOUR_LOUPS.Fiche.Vivant"}}</label>
        <label class="case"><input type="checkbox" name="system.revele" {{checked system.revele}}> {{localize "LAKOUR_LOUPS.Fiche.Revele"}}</label>
        <label class="case"><input type="checkbox" name="system.silence" {{checked system.silence}}> {{localize "LAKOUR_LOUPS.Table.Silence"}}</label>
      </div>
    </section>
    {{/if}}

    <section class="loups-encart loups-notes">
      <h3><i class="fa-solid fa-feather"></i> {{localize "LAKOUR_LOUPS.Fiche.Notes"}}</h3>
      {{#if editable}}
      <prose-mirror name="system.notes" value="{{system.notes}}" toggled data-document-uuid="{{acteur.uuid}}">{{{notesEnrichies}}}</prose-mirror>
      {{else}}<div class="loups-texte">{{{notesEnrichies}}}</div>{{/if}}
    </section>
  </div>
</div>

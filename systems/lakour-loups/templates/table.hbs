<div class="loups-table-corps {{#if estNuit}}nuit{{else}}jour{{/if}}">
  <header class="loups-bandeau">
    <div class="loups-phase">
      <span class="loups-phase-icone"><i class="fa-solid {{#if estNuit}}fa-moon{{else}}fa-sun{{/if}}"></i></span>
      <div>
        <div class="loups-phase-nom">{{phaseLibelle}}</div>
        <div class="loups-phase-tour">{{localize "LAKOUR_LOUPS.Table.Tour"}} {{tour}}{{#if composition}} · {{composition}}{{/if}}{{#if tablee}} · <span class="loups-pastille tablee"><i class="fa-solid fa-chair"></i> {{localize "LAKOUR_LOUPS.Tablee.Nom"}}</span>{{/if}}{{#if peste}} · <span class="loups-pastille peste" data-tooltip="{{localize 'LAKOUR_LOUPS.Peste.PartieAide'}}"><i class="fa-solid fa-biohazard"></i> {{localize "LAKOUR_LOUPS.Peste.Partie"}}</span>{{/if}}</div>
      </div>
    </div>
    {{#if bailli}}
    <div class="loups-bailli-tete {{#if bailli.vacant}}vacant{{/if}}" data-tooltip="{{localize 'LAKOUR_LOUPS.Bailli.Aide'}}">
      <i class="fa-solid fa-stamp"></i>
      {{#if bailli.vacant}}{{#if bailli.succession}}{{loupsT "LAKOUR_LOUPS.Bailli.Sceau" nom=bailli.succession}}{{else}}{{localize "LAKOUR_LOUPS.Bailli.Vacant"}}{{/if}}
      {{else}}{{loupsT "LAKOUR_LOUPS.Bailli.Bandeau" nom=bailli.nom}}{{#if bailli.moi}} <small>({{localize "LAKOUR_LOUPS.Table.Vous"}})</small>{{/if}}{{/if}}
    </div>
    {{/if}}
    {{#if presage}}<div class="loups-presage" data-tooltip="{{presage.effet}}"><i class="fa-solid fa-cloud-moon"></i> {{presage.nom}}</div>{{/if}}
    {{#if glas}}<div class="loups-glas" data-tooltip="{{localize 'LAKOUR_LOUPS.Calendrier.GlasAide'}}"><i class="fa-solid fa-bell"></i> {{loupsT "LAKOUR_LOUPS.Calendrier.Glas" n=glas}}</div>{{/if}}
    {{#if deuil}}<div class="loups-glas loups-deuil" data-tooltip="{{localize 'LAKOUR_LOUPS.Deuil.Aide'}}"><i class="fa-solid fa-bell"></i> {{loupsT "LAKOUR_LOUPS.Deuil.Compte" n=deuil.compte}}</div>{{/if}}
    {{#if saintMartin}}<div class="loups-presage loups-saint-martin" data-tooltip="{{localize 'LAKOUR_LOUPS.SaintMartin.Aide'}}"><i class="fa-solid fa-church"></i> {{localize "LAKOUR_LOUPS.SaintMartin.Titre"}}</div>{{/if}}
    {{#if fete}}<div class="loups-presage loups-fete" data-tooltip="{{fete.aide}}"><i class="fa-solid fa-star"></i> {{fete.nom}}{{#if fete.neige}} · <i class="fa-solid fa-snowflake"></i> {{localize "LAKOUR_LOUPS.Fetes.Neige"}}{{/if}}{{#if fete.defile}} · <i class="fa-solid fa-masks-theater"></i> {{loupsT "LAKOUR_LOUPS.Fetes.Defile" role=fete.defile}}{{/if}}{{#if fete.secrets}} · <small class="loups-mj-seul">{{fete.secrets}}</small>{{/if}}</div>{{/if}}
    <div class="loups-minuteur" aria-live="polite"></div>
    {{#if moi}}
    <div class="loups-moi">
      <span class="loups-etiquette">{{localize "LAKOUR_LOUPS.Table.Vous"}}</span> {{moi.nom}}
      {{#unless moi.vivant}}<span class="loups-pastille mort">{{localize "LAKOUR_LOUPS.Table.Mort"}}</span>{{/unless}}
      {{#if moi.silence}}<span class="loups-pastille silence"><i class="fa-solid fa-comment-slash"></i> {{localize "LAKOUR_LOUPS.Table.Silence"}}</span>{{/if}}
      {{#if carnet}}<button type="button" class="loups-bouton discret" data-action="carnet"><i class="fa-solid fa-envelope-open-text"></i> {{localize "LAKOUR_LOUPS.Carnet.Titre"}} ({{carnetNombre}})</button>{{/if}}
      {{#if quitter}}<button type="button" class="loups-bouton discret" data-action="quitter" data-tooltip="{{localize 'LAKOUR_LOUPS.Passage.QuitterAide'}}"><i class="fa-solid fa-door-open"></i> {{localize "LAKOUR_LOUPS.Passage.Quitter"}}</button>{{/if}}
    </div>
    {{/if}}
  </header>

  {{#if secretsPerdus}}
  <div class="loups-alerte"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "LAKOUR_LOUPS.Table.SecretsPerdus"}}</div>
  {{/if}}
  {{#if etape}}
  <div class="loups-etape-ligne {{#if etape.attente}}attente{{/if}}" aria-live="polite">
    <i class="fa-solid {{#if etape.attente}}fa-hourglass-half{{else}}fa-shoe-prints{{/if}}"></i>
    <span class="loups-etiquette">{{localize "LAKOUR_LOUPS.Etapes.Prochaine"}}</span>
    <strong>{{etape.texte}}</strong>{{#if etape.detail}} <small>{{etape.detail}}</small>{{/if}}
  </div>
  {{/if}}
  {{#if preparation}}
  <section class="loups-encart loups-preparation">
    <h3><i class="fa-solid fa-users"></i> {{localize "LAKOUR_LOUPS.Preparation.Titre"}} <span class="loups-compte">{{preparation.total}}</span></h3>
    {{!-- Les onglets de la préparation (l'onglet ouvert est retenu par navigateur : table.mjs, ONGLET_RETENU) ; la distribution et le
         résumé des choix restent toujours visibles dessous. --}}
    <nav class="loups-prep-onglets" role="tablist">
      {{#each preparation.onglets}}<button type="button" role="tab" class="loups-prep-onglet-bouton{{#if actif}} actif{{/if}}" data-action="prepOnglet" data-onglet="{{cle}}" aria-selected="{{#if actif}}true{{else}}false{{/if}}"><i class="fa-solid {{icone}}"></i> {{libelle}}</button>{{/each}}
    </nav>
    <div class="loups-prep-onglet" data-onglet="joueurs" role="tabpanel" {{#unless preparation.ouvert.joueurs}}hidden{{/unless}}>
      <div class="loups-prep-ligne">
        <span class="loups-etiquette">{{localize "LAKOUR_LOUPS.Preparation.Joueurs"}}</span>
        {{#each preparation.joueurs}}
        <label class="loups-prep-joueur"><input type="checkbox" data-action="prepCocher" data-id="{{id}}" {{#if coche}}checked{{/if}}> {{nom}}</label>
        {{else}}<span class="loups-vide">{{localize "LAKOUR_LOUPS.Preparation.PersonneConnecte"}}</span>{{/each}}
      </div>
      <div class="loups-prep-ligne">
        <span class="loups-etiquette">{{localize "LAKOUR_LOUPS.Preparation.JoueursIA"}}</span>
        {{#if preparation.ia.disponible}}
        <button type="button" class="loups-bouton discret" data-action="prepRetirerIA" {{#unless preparation.ia.n}}disabled{{/unless}} aria-label="{{localize 'LAKOUR_LOUPS.Preparation.RetirerIA'}}">−</button>
        <strong class="loups-prep-compteur">{{preparation.ia.n}}</strong>
        <button type="button" class="loups-bouton discret" data-action="prepIA"><i class="fa-solid fa-robot"></i> {{localize "LAKOUR_LOUPS.Preparation.AjouterIA"}}</button>
        {{#if preparation.ia.noms}}<small>{{preparation.ia.noms}}</small>{{/if}}
        {{else}}
        <span class="loups-vide loups-grise">{{localize "LAKOUR_LOUPS.Preparation.IAAbsente"}}</span>
        {{/if}}
      </div>
      {{#unless preparation.voix.pret}}
      <div class="loups-prep-ligne loups-prep-voix">
        <span class="loups-etiquette"><i class="fa-solid fa-microphone"></i> {{localize "LAKOUR_LOUPS.Preparation.Voix.Titre"}}</span>
        {{#if preparation.voix.desactive}}
        <span>{{localize "LAKOUR_LOUPS.Preparation.Voix.Desactivee"}}</span>
        <button type="button" class="loups-bouton discret" data-action="voixActiver" data-tooltip="{{localize 'LAKOUR_LOUPS.Preparation.Voix.ActiverAide'}}"><i class="fa-solid fa-microphone"></i> {{localize "LAKOUR_LOUPS.Preparation.Voix.Activer"}}</button>
        {{/if}}
        {{#if preparation.voix.muets}}
        <span>{{loupsT "LAKOUR_LOUPS.Preparation.Voix.Muets" noms=preparation.voix.muets}}</span>
        <button type="button" class="loups-bouton discret" data-action="voixMicro" data-tooltip="{{localize 'LAKOUR_LOUPS.Preparation.Voix.MicroAide'}}"><i class="fa-solid fa-user-check"></i> {{localize "LAKOUR_LOUPS.Preparation.Voix.Micro"}}</button>
        {{/if}}
      </div>
      {{/unless}}
    </div>
    <div class="loups-prep-onglet" data-onglet="composition" role="tabpanel" {{#unless preparation.ouvert.composition}}hidden{{/unless}}>
      <div class="loups-prep-ligne">
        <span class="loups-etiquette">{{localize "LAKOUR_LOUPS.Preparation.Composition"}}</span>
        <button type="button" class="loups-bouton {{#unless preparation.auto}}discret{{/unless}}" data-action="prepMode" data-mode="auto">{{localize "LAKOUR_LOUPS.Preparation.Auto"}}</button>
        <button type="button" class="loups-bouton {{#unless preparation.manuel}}discret{{/unless}}" data-action="prepMode" data-mode="manuel">{{localize "LAKOUR_LOUPS.Preparation.Manuel"}}</button>
        <select name="prepNiveau">{{#each preparation.niveaux}}<option value="{{cle}}" {{#if choisi}}selected{{/if}}>{{libelle}}</option>{{/each}}</select>
      </div>
      {{#if preparation.conseil}}<p class="loups-alerte">{{preparation.conseil}}</p>{{/if}}
      {{#if preparation.tablee}}
      <div class="loups-prep-ligne loups-prep-tablee">
        <small>{{preparation.tablee.aide}}</small>
        {{#if preparation.tablee.avis}}<p class="loups-alerte">{{preparation.tablee.avis}}</p>{{/if}}
      </div>
      {{/if}}
      {{#if preparation.manuel}}
      <ul class="loups-prep-roles">
        {{#each preparation.roles}}
        <li class="camp-{{camp}}"><span class="loups-nom">{{nom}}</span> <span class="loups-camp">{{campLibelle}}</span>
          <span class="loups-prep-nombre">
            <button type="button" data-action="prepRole" data-cle="{{cle}}" data-delta="-1" aria-label="−">−</button><strong>{{n}}</strong><button type="button" data-action="prepRole" data-cle="{{cle}}" data-delta="1" aria-label="+">+</button>
          </span></li>
        {{/each}}
      </ul>
      {{#if preparation.equilibre}}<p class="loups-prep-equilibre verdict-{{preparation.equilibre.verdict}}"><i class="fa-solid fa-scale-balanced"></i> {{preparation.equilibre.texte}} · {{preparation.equilibre.loupsTexte}}</p>{{/if}}
      {{#if preparation.trop}}<p class="loups-alerte">{{localize "LAKOUR_LOUPS.Preparation.Trop"}}</p>{{/if}}
      {{/if}}
    </div>
    <div class="loups-prep-onglet" data-onglet="village" role="tabpanel" {{#unless preparation.ouvert.village}}hidden{{/unless}}>
      <div class="loups-prep-ligne">
        <span class="loups-etiquette">{{localize "LAKOUR_LOUPS.Preparation.Formats"}}</span>
        <label class="loups-prep-joueur" data-tooltip="{{localize 'LAKOUR_LOUPS.Peste.PreparationAide'}}"><input type="checkbox" data-action="prepPeste" {{#if preparation.peste}}checked{{/if}}> <i class="fa-solid fa-biohazard"></i> {{localize "LAKOUR_LOUPS.Peste.Preparation"}}</label>
        <label class="loups-prep-joueur" data-tooltip="{{localize 'LAKOUR_LOUPS.SaintMartin.PreparationAide'}}"><input type="checkbox" data-action="prepSaintMartin" {{#if preparation.saintMartin}}checked{{/if}}> <i class="fa-solid fa-church"></i> {{localize "LAKOUR_LOUPS.SaintMartin.Preparation"}}</label>
        {{#if preparation.villagePossible}}<label class="loups-prep-joueur" data-tooltip="{{localize 'LAKOUR_LOUPS.Village.PreparationAide'}}"><input type="checkbox" data-action="prepVillage" {{#if preparation.village}}checked{{/if}}> <i class="fa-solid fa-house-chimney-window"></i> {{localize "LAKOUR_LOUPS.Village.Preparation"}}</label>{{/if}}
      </div>
      {{#if preparation.batiments}}
      <div class="loups-prep-ligne loups-prep-batiments">
        <span class="loups-etiquette" data-tooltip="{{localize 'LAKOUR_LOUPS.Preparation.Batiments.Aide'}}">{{localize "LAKOUR_LOUPS.Preparation.Batiments.Titre"}}</span>
        <select name="prepBatiments">{{#each preparation.batiments.modes}}<option value="{{cle}}" {{#if choisi}}selected{{/if}}>{{nom}}</option>{{/each}}</select>
        {{#each preparation.batiments.liste}}<label class="loups-prep-joueur"><input type="checkbox" data-action="prepBatiment" data-cle="{{cle}}" {{#if coche}}checked{{/if}}> {{nom}}</label>{{/each}}
        <label class="loups-prep-joueur" data-tooltip="{{localize 'LAKOUR_LOUPS.Preparation.MetiersAide'}}"><input type="checkbox" data-action="prepMetiers" {{#if preparation.batiments.metiers}}checked{{/if}}> <i class="fa-solid fa-hammer"></i> {{localize "LAKOUR_LOUPS.Preparation.Metiers"}}</label>
      </div>
      {{/if}}
    </div>
    <div class="loups-prep-onglet" data-onglet="variantes" role="tabpanel" {{#unless preparation.ouvert.variantes}}hidden{{/unless}}>
      {{#if preparation.variantes}}
      <div class="loups-prep-ligne loups-prep-variantes">
        <span class="loups-etiquette" data-tooltip="{{localize 'LAKOUR_LOUPS.Variantes.PreparationAide'}}">{{localize "LAKOUR_LOUPS.Variantes.Titre"}}</span>
        {{#each preparation.variantes.cases}}<label class="loups-prep-joueur" data-tooltip="{{aide}}"><input type="checkbox" data-action="prepVariante" data-cle="{{cle}}" {{#if coche}}checked{{/if}}> <i class="fa-solid {{icone}}"></i> {{nom}}</label>{{/each}}
        {{#if preparation.variantes.doubleVisage}}<label class="loups-prep-joueur" data-tooltip="{{localize 'LAKOUR_LOUPS.Variantes.DoubleVisage.Aide'}}"><i class="fa-solid fa-masks-theater"></i> {{localize "LAKOUR_LOUPS.Variantes.DoubleVisage.Nom"}}
          <select name="prepDoubleVisage">{{#each preparation.variantes.doubleVisage}}<option value="{{cle}}" {{#if choisi}}selected{{/if}}>{{nom}}</option>{{/each}}</select></label>{{/if}}
        {{#if preparation.variantes.allegeance}}<label class="loups-prep-joueur" data-tooltip="{{preparation.variantes.allegeance.aide}}"><input type="checkbox" data-action="prepVariante" data-cle="{{preparation.variantes.allegeance.cle}}" {{#if preparation.variantes.allegeance.coche}}checked{{/if}}> <i class="fa-solid fa-paw"></i> {{preparation.variantes.allegeance.nom}}</label>{{/if}}
      </div>
      {{/if}}
    </div>
    <div class="loups-prep-onglet" data-onglet="gazette" role="tabpanel" {{#unless preparation.ouvert.gazette}}hidden{{/unless}}>
      {{#if preparation.gazette}}
      <div class="loups-prep-ligne loups-prep-gazette">
        <label class="loups-prep-joueur" data-tooltip="{{localize 'LAKOUR_LOUPS.Preparation.GazetteAide'}}"><input type="checkbox" data-action="prepGazette" data-cle="actif" {{#if preparation.gazette.actif}}checked{{/if}}> <i class="fa-solid fa-newspaper"></i> {{localize "LAKOUR_LOUPS.Preparation.Gazette"}}</label>
        <label class="loups-prep-joueur" data-tooltip="{{localize 'LAKOUR_LOUPS.Preparation.CrieurAide'}}"><input type="checkbox" data-action="prepGazette" data-cle="crieur" {{#if preparation.gazette.crieur}}checked{{/if}}> <i class="fa-solid fa-bullhorn"></i> {{localize "LAKOUR_LOUPS.Preparation.Crieur"}}</label>
        {{#if preparation.gazette.permanentes.length}}<span class="loups-etiquette">{{localize "LAKOUR_LOUPS.Preparation.Permanentes"}}</span>
        {{#each preparation.gazette.permanentes}}<label class="loups-prep-joueur" data-tooltip="{{aide}}"><input type="checkbox" data-action="prepPermanente" data-cle="{{cle}}" {{#if coche}}checked{{/if}}> {{nom}}</label>{{/each}}{{/if}}
      </div>
      {{/if}}
      {{#if preparation.fetes}}{{#unless preparation.fetes.saintMartin}}
      <div class="loups-prep-ligne loups-prep-fete">
        <span class="loups-etiquette"><i class="fa-solid fa-star"></i> {{localize "LAKOUR_LOUPS.Fetes.Preparation"}}</span>
        <select name="prepFete" data-tooltip="{{preparation.fetes.aide}}">{{#each preparation.fetes.options}}<option value="{{cle}}" {{#if choisie}}selected{{/if}}>{{nom}}</option>{{/each}}</select>
        <small>{{preparation.fetes.aide}}</small>
      </div>
      {{/unless}}{{/if}}
    </div>
    {{#if preparation.trop}}{{#unless preparation.ouvert.composition}}<p class="loups-alerte">{{localize "LAKOUR_LOUPS.Preparation.Trop"}}</p>{{/unless}}{{/if}}
    <p class="loups-prep-resume"><i class="fa-solid fa-list-check"></i> {{preparation.resume}}</p>
    <div class="loups-actions">
      <button type="button" data-action="distribuer" {{#unless preparation.peutDistribuer}}disabled{{/unless}}><i class="fa-solid fa-shuffle"></i> {{localize "LAKOUR_LOUPS.Preparation.Distribuer"}}</button>
    </div>
  </section>
  {{/if}}
  {{#if vainqueur}}
  <div class="loups-victoire"><i class="fa-solid fa-crown"></i> {{vainqueur}}</div>
  {{/if}}

  <div class="loups-colonnes">
    <section class="loups-colonne loups-village">
      {{#if vote.ouvert}}
      <div class="loups-vote-bandeau">
        <i class="fa-solid fa-scale-balanced"></i>
        <strong>{{#if vote.chapelle}}{{localize "LAKOUR_LOUPS.Vote.QuestionChapelle"}}{{else if vote.bailli}}{{localize "LAKOUR_LOUPS.Vote.QuestionBailli"}}{{else if vote.exil}}{{localize "LAKOUR_LOUPS.Passage.QuestionExil"}}{{else if vote.banc}}{{loupsT "LAKOUR_LOUPS.Banc.Question" nom=vote.banc}}{{else}}{{localize "LAKOUR_LOUPS.Vote.EnCours"}}{{/if}}</strong>
        <span>{{vote.exprimes}} / {{vote.votants}} {{localize "LAKOUR_LOUPS.Vote.OntVote"}}{{#if vote.souffles}} · {{loupsT "LAKOUR_LOUPS.Souffle.Compte" n=vote.souffles}}{{/if}}</span>
        {{#if vote.double}}<span class="loups-pastille cloche"><i class="fa-solid fa-bell"></i> {{localize "LAKOUR_LOUPS.Vote.Double"}}</span>{{/if}}
        {{#if vote.majoriteAbsolue}}<span class="loups-pastille gibet">{{localize "LAKOUR_LOUPS.Vote.MajoriteAbsolue"}}</span>{{/if}}
        {{#if vote.voixDouble}}<span class="loups-pastille bailli"><i class="fa-solid fa-stamp"></i> {{loupsT "LAKOUR_LOUPS.Bailli.VoixDouble" nom=vote.voixDouble}}</span>{{/if}}
        {{#if vote.mainLevee}}<span class="loups-pastille jour"><i class="fa-solid fa-hand"></i> {{localize "LAKOUR_LOUPS.Vote.MainLevee"}}</span>{{/if}}
        {{#if vote.souffle}}{{#if vote.peutVoter}}<span class="loups-pastille mort"><i class="fa-solid fa-wind"></i> {{localize "LAKOUR_LOUPS.Souffle.Voter"}}</span>{{/if}}{{/if}}
        {{#if vote.peutVoter}}<button type="button" class="loups-bouton discret" data-action="abstenir">{{localize "LAKOUR_LOUPS.Vote.Abstention"}}</button>{{/if}}
      </div>
      {{/if}}

      <h2 class="loups-titre"><i class="fa-solid fa-house-chimney"></i> {{localize "LAKOUR_LOUPS.Table.Vivants"}} <span class="loups-compte">{{vivants.length}}</span></h2>
      <ul class="loups-grille">
        {{#each vivants}}
        <li class="loups-carte {{#if moi}}moi{{/if}} {{#if monChoix}}choisi{{/if}} {{#if elu}}elu{{/if}} camp-{{campCle}}">
          <img class="loups-portrait" src="{{img}}" alt="" data-action="fiche" data-id="{{id}}">
          <div class="loups-carte-texte">
            <div class="loups-nom" data-action="fiche" data-id="{{id}}">{{nom}}</div>
            <div class="loups-detail">{{#if maison}}<i class="fa-solid fa-door-closed"></i> {{maison}}{{/if}}</div>
            {{#if metier}}<div class="loups-detail metier"><i class="fa-solid fa-hammer"></i> {{metier}}</div>{{/if}}
            {{#if chandelle}}<div class="loups-detail chandelle {{chandelle.cle}}" data-tooltip="{{chandelle.aide}}"><i class="fa-solid {{chandelle.icone}}"></i> {{chandelle.texte}}</div>{{/if}}
            {{#if personnalite}}<div class="loups-detail personnalite" data-tooltip="{{personnaliteAide}}"><i class="fa-solid fa-house-chimney-window"></i> {{personnalite}}</div>{{/if}}
            {{#if traits}}<div class="loups-detail traits" data-tooltip="{{localize 'LAKOUR_LOUPS.Traits.Aide'}}"><i class="fa-solid fa-user-tag"></i> {{traits}}</div>{{/if}}
            {{#if crieur}}<div class="loups-detail charge"><i class="fa-solid fa-bullhorn"></i> {{localize "LAKOUR_LOUPS.Gazette.Table.Crieur"}}</div>{{/if}}
            {{#if executeur}}<div class="loups-detail charge"><i class="fa-solid fa-gavel"></i> {{localize "LAKOUR_LOUPS.Gazette.Executeur.Titre"}}</div>{{/if}}
            {{#if absent}}<div class="loups-detail absent"><i class="fa-solid fa-person-walking-arrow-right"></i> {{localize "LAKOUR_LOUPS.Gazette.Table.Absent"}}{{#if protegeGazette}} · {{localize "LAKOUR_LOUPS.Gazette.Table.Danseur"}}{{/if}}</div>{{/if}}
            {{#if priveGazette}}<div class="loups-detail absent"><i class="fa-solid fa-ban"></i> {{localize "LAKOUR_LOUPS.Gazette.Table.Prive"}}</div>{{/if}}
            {{#if voitRole}}{{#if roleNom}}<div class="loups-role {{#if revele}}revele{{/if}}"><i class="fa-solid fa-mask"></i> {{roleNom}} <span class="loups-camp">{{camp}}</span></div>{{/if}}{{/if}}
            {{#unless voitRole}}{{#if passage}}<div class="loups-role passage" data-tooltip="{{localize 'LAKOUR_LOUPS.Passage.Aide'}}"><i class="fa-solid fa-person-walking-luggage"></i> {{passage}}</div>{{/if}}{{/unless}}
            {{#if amoureux}}<div class="loups-detail mj"><i class="fa-solid fa-heart"></i> {{amoureux}}</div>{{/if}}
            {{#if protections}}<div class="loups-detail mj"><i class="fa-solid fa-shield-halved"></i> {{protections}}</div>{{/if}}
          </div>
          <div class="loups-carte-etat">
            {{#if silence}}<i class="fa-solid fa-comment-slash" title="{{localize 'LAKOUR_LOUPS.Table.Silence'}}"></i>{{/if}}
            {{#if benit}}<i class="fa-solid fa-hands-praying" title="{{localize 'LAKOUR_LOUPS.Table.Benit'}}"></i>{{/if}}
            {{#if ruban}}<i class="fa-solid fa-ribbon" title="{{localize 'LAKOUR_LOUPS.Table.Ruban'}}"></i>{{/if}}
            {{#if bailli}}<i class="fa-solid fa-stamp loups-sceau" title="{{localize 'LAKOUR_LOUPS.Bailli.Titre'}}"></i>{{/if}}
            {{#if somnambule}}<i class="fa-solid fa-bed" title="{{localize 'LAKOUR_LOUPS.Somnambule.MJ'}}"></i>{{/if}}
            {{#if aVote}}<i class="fa-solid fa-check-to-slot" title="{{localize 'LAKOUR_LOUPS.Vote.AVote'}}"></i>{{/if}}
            {{#if montreVoix}}<span class="loups-voix">{{voix}}</span>{{/if}}
          </div>
          {{#if candidat}}{{#if @root.vote.peutVoter}}
          <button type="button" class="loups-bouton voter {{#if monChoix}}actif{{/if}}" data-action="voter" data-id="{{id}}">
            <i class="fa-solid fa-hand-point-up"></i> {{#if monChoix}}{{localize "LAKOUR_LOUPS.Vote.VotreChoix"}}{{else}}{{localize "LAKOUR_LOUPS.Vote.Voter"}}{{/if}}
          </button>
          {{/if}}{{/if}}
          {{#if @root.gm}}
          <div class="loups-mj-boutons">
            <button type="button" data-action="reveler" data-id="{{id}}" title="{{localize 'LAKOUR_LOUPS.Table.Reveler'}}"><i class="fa-solid fa-eye"></i></button>
            <button type="button" data-action="eliminer" data-id="{{id}}" title="{{localize 'LAKOUR_LOUPS.Table.Eliminer'}}"><i class="fa-solid fa-skull"></i></button>
            {{#if crier}}<button type="button" data-action="crier" data-id="{{id}}" title="{{loupsT 'LAKOUR_LOUPS.Table.CrierPour' nom=nom}}"><i class="fa-solid fa-biohazard"></i></button>{{/if}}
            {{#if faireQuitter}}<button type="button" data-action="faireQuitter" data-id="{{id}}" title="{{localize 'LAKOUR_LOUPS.Passage.FaireQuitter'}}"><i class="fa-solid fa-door-open"></i></button>{{/if}}
          </div>
          {{/if}}
        </li>
        {{else}}
        <li class="loups-vide">{{localize "LAKOUR_LOUPS.Table.PersonneEnVie"}}</li>
        {{/each}}
      </ul>

      {{#if morts.length}}
      <h2 class="loups-titre"><i class="fa-solid fa-cross"></i> {{localize "LAKOUR_LOUPS.Table.Cimetiere"}} <span class="loups-compte">{{morts.length}}</span></h2>
      <ul class="loups-grille morts">
        {{#each morts}}
        <li class="loups-carte mort camp-{{campCle}}">
          <img class="loups-portrait" src="{{img}}" alt="" data-action="fiche" data-id="{{id}}">
          <div class="loups-carte-texte">
            <div class="loups-nom">{{nom}}</div>
            <div class="loups-detail">{{#if parti}}<i class="fa-solid fa-door-open"></i> {{parti}}{{else}}{{cause}}{{#if tourMort}} · {{localize "LAKOUR_LOUPS.Table.Tour"}} {{tourMort}}{{/if}}{{/if}}{{#if souffle}} · <i class="fa-solid fa-wind" title="{{localize 'LAKOUR_LOUPS.Souffle.Garde'}}"></i>{{/if}}</div>
            {{#if metier}}<div class="loups-detail metier"><i class="fa-solid fa-hammer"></i> {{metier}}</div>{{/if}}
            {{#if roleNom}}<div class="loups-role revele"><i class="fa-solid fa-mask"></i> {{roleNom}} <span class="loups-camp">{{camp}}</span></div>{{/if}}
          </div>
          {{#if @root.gm}}<div class="loups-mj-boutons"><button type="button" data-action="reveler" data-id="{{id}}" title="{{localize 'LAKOUR_LOUPS.Table.Reveler'}}"><i class="fa-solid fa-eye"></i></button></div>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </section>

    <aside class="loups-colonne loups-cote">
      {{#if crier}}
      <section class="loups-encart loups-cri">
        <button type="button" class="loups-bouton" data-action="crier" data-id="{{moiId}}" data-tooltip="{{localize 'LAKOUR_LOUPS.Peste.CrierAide'}}"><i class="fa-solid fa-biohazard"></i> {{localize "LAKOUR_LOUPS.Peste.Crier"}}</button>
      </section>
      {{/if}}
      {{#if banc}}
      <section class="loups-encart loups-banc">
        <h3><i class="fa-solid fa-hand-point-right"></i> {{localize "LAKOUR_LOUPS.Banc.Titre"}}</h3>
        {{#if banc.accusations.length}}
        <ul class="loups-journal">{{#each banc.accusations}}<li class="{{#if juge}}fait{{/if}}">{{loupsT "LAKOUR_LOUPS.Banc.Ligne" nom=parNom contre=contreNom}}{{#if juge}} <small>({{localize "LAKOUR_LOUPS.Banc.Juge"}})</small>{{/if}}</li>{{/each}}</ul>
        {{else}}<p class="loups-vide">{{localize "LAKOUR_LOUPS.Banc.Vide"}}</p>{{/if}}
        {{#if accusation}}{{#if accusation.ok}}
        <div class="loups-declarer">
          <select name="accuse" aria-label="{{localize 'LAKOUR_LOUPS.Banc.Accuser'}}">{{#each accusation.cibles}}<option value="{{id}}">{{nom}}</option>{{/each}}</select>
          <button type="button" class="loups-bouton discret" data-action="accuser" data-tooltip="{{localize 'LAKOUR_LOUPS.Banc.AccuserAide'}}"><i class="fa-solid fa-hand-point-right"></i> {{localize "LAKOUR_LOUPS.Banc.Accuser"}}</button>
        </div>
        {{else}}{{#if accusation.raison}}<p class="loups-vide"><small>{{accusation.raison}}</small></p>{{/if}}{{/if}}{{/if}}
      </section>
      {{/if}}
      {{#if variantes}}
      <section class="loups-encart loups-variantes-encart">
        <h3><i class="fa-solid fa-book-open"></i> {{variantes.titre}}</h3>
        {{#if variantes.chaine}}<p><strong>{{localize "LAKOUR_LOUPS.Variantes.Chaine.Nom"}}</strong> — {{variantes.chaine.debout}}<br><small>{{variantes.chaine.designateur}}</small></p>{{/if}}
        {{#if variantes.mur}}<p><strong>{{localize "LAKOUR_LOUPS.Variantes.Mur.Nom"}}</strong></p><ul class="loups-journal">{{#each variantes.mur}}<li>« {{this}} »</li>{{/each}}</ul>{{/if}}
      </section>
      {{/if}}
      {{#if gazette}}
      <section class="loups-encart loups-gazette-encart">
        <h3 data-tooltip="{{gazette.aides}}"><i class="fa-solid fa-newspaper"></i> {{localize "LAKOUR_LOUPS.Gazette.Titre"}}</h3>
        {{#if gazette.derniere}}<p>{{gazette.derniere}}</p>{{/if}}
        {{#if gazette.enJeu}}<p><small>{{gazette.enJeu}}</small></p>{{/if}}
        {{#if gazette.restantes}}<p><small>{{gazette.restantes}}</small></p>{{/if}}
        {{#if gazette.crieur}}<p><i class="fa-solid fa-bullhorn"></i> {{gazette.crieur}}</p>{{/if}}
        {{#if gazette.executeur}}<p><i class="fa-solid fa-gavel"></i> {{gazette.executeur}}</p>{{/if}}
        {{#if gazette.seances}}<p><small>{{gazette.seances}}</small></p>{{/if}}
        {{#if gazette.reponse}}<p><small>{{gazette.reponse}}</small></p>{{/if}}
        {{#each gazette.secrets}}<p class="loups-mj-seul"><small>{{this}}</small></p>{{/each}}
        {{#if gazette.lire}}<div class="loups-ligne"><select name="gazetteCarte" aria-label="{{localize 'LAKOUR_LOUPS.Gazette.Table.Lire'}}">{{#each gazette.lire}}<option value="{{cle}}">{{nom}}</option>{{/each}}</select>
          <button type="button" class="loups-bouton discret" data-action="gazetteLire"><i class="fa-solid fa-newspaper"></i> {{localize "LAKOUR_LOUPS.Gazette.Table.Lire"}}</button></div>{{/if}}
        {{#if gazette.priver}}<div class="loups-ligne" data-tooltip="{{localize 'LAKOUR_LOUPS.Gazette.Table.PriverAide'}}"><select name="gazettePrive" aria-label="{{localize 'LAKOUR_LOUPS.Gazette.Table.Priver'}}">{{#each gazette.priver}}<option value="{{id}}">{{nom}}</option>{{/each}}</select>
          <button type="button" class="loups-bouton discret" data-action="gazettePriver"><i class="fa-solid fa-ban"></i> {{localize "LAKOUR_LOUPS.Gazette.Table.Priver"}}</button></div>{{/if}}
        {{#if gazette.variante}}<button type="button" class="loups-bouton discret" data-action="gazetteVariante"><i class="fa-solid fa-book-open"></i> {{loupsT "LAKOUR_LOUPS.Gazette.Table.Variante" nom=gazette.variante}}</button>{{/if}}
        {{#if gazette.elireExecuteur}}<button type="button" class="loups-bouton" data-action="voteExecuteur"><i class="fa-solid fa-gavel"></i> {{localize "LAKOUR_LOUPS.Gazette.Table.ElireExecuteur"}}</button>{{/if}}
      </section>
      {{/if}}
      {{#if village}}
      <section class="loups-encart loups-village-encart">
        <h3 data-tooltip="{{localize 'LAKOUR_LOUPS.Village.Aide'}}"><i class="fa-solid fa-house-chimney-window"></i> {{localize "LAKOUR_LOUPS.Village.Titre"}}</h3>
        <ul class="loups-journal">
          {{#each village.batiments}}
          <li data-tooltip="{{aide}}"><strong>{{nom}}</strong> — {{titre}} :
            {{#if @root.village.preparation}}<select name="villageOccupant" data-cle="{{cle}}" aria-label="{{nom}}">{{#each options}}<option value="{{id}}" {{#if choisi}}selected{{/if}}>{{nom}}</option>{{/each}}</select>
            {{else}}{{#if occupant}}{{occupant}}{{else}}{{localize "LAKOUR_LOUPS.Village.Vacant"}}{{/if}}{{#if epuise}} <small>({{localize "LAKOUR_LOUPS.Village.Epuise"}})</small>{{/if}}{{/if}}
          </li>
          {{/each}}
        </ul>
        {{#if village.chemineaux}}<p><small>{{loupsT "LAKOUR_LOUPS.Village.Chemineaux" noms=village.chemineaux}}</small></p>{{/if}}
        {{#if village.detruits}}<p><small>{{village.detruits}}</small></p>{{/if}}
        {{#if village.prives}}<p class="loups-alerte"><small>{{village.prives}}</small></p>{{/if}}
      </section>
      {{/if}}
      {{#if pouvoirs.length}}
      <section class="loups-encart">
        <h3><i class="fa-solid fa-hand-sparkles"></i> {{localize "LAKOUR_LOUPS.Table.Pouvoirs"}}</h3>
        <ul class="loups-pouvoirs">
          {{#each pouvoirs}}
          <li><button type="button" class="loups-bouton {{#unless possible}}discret{{/unless}}" data-action="pouvoir" data-pouvoir="{{pouvoir}}" {{#if description}}data-tooltip="{{description}}"{{/if}}>{{nom}}</button>{{#unless possible}} <small>{{raison}}</small>{{/unless}}</li>
          {{/each}}
        </ul>
      </section>
      {{/if}}

      {{#if conteuse}}<p class="loups-alerte"><i class="fa-solid fa-book-open-reader"></i> {{loupsT "LAKOUR_LOUPS.Table.Conteuse" nom=conteuse}}</p>{{/if}}
      {{#if appel}}<p class="loups-alerte"><i class="fa-solid fa-chalkboard-user"></i> {{localize "LAKOUR_LOUPS.Table.Appel"}} {{appel}}</p>{{/if}}
      {{#if effets.length}}
      <section class="loups-encart">
        <h3><i class="fa-solid fa-moon"></i> {{localize "LAKOUR_LOUPS.Table.NuitProchaine"}}</h3>
        <ul class="loups-journal">{{#each effets}}<li><strong>{{libelle}}</strong> {{noms}}</li>{{/each}}</ul>
      </section>
      {{/if}}

      {{#if vote.resultat}}
      <section class="loups-encart">
        <h3><i class="fa-solid fa-scale-balanced"></i> {{localize "LAKOUR_LOUPS.Vote.Resultat"}}</h3>
        {{#if vote.resultat.lignes.length}}
        <ol class="loups-decompte">
          {{#each vote.resultat.lignes}}<li class="{{#if elu}}elu{{/if}}"><span>{{nom}}</span><span class="loups-voix">{{voix}}</span></li>{{/each}}
        </ol>
        {{/if}}
        <p class="loups-verdict">
          {{#if vote.resultat.departage.enAttente}}<i class="fa-solid fa-hourglass-half"></i> {{loupsT "LAKOUR_LOUPS.Bailli.Tranchera" nom=vote.resultat.departage.nom}}
          {{else if vote.resultat.personne}}{{#if vote.resultat.bailli}}{{localize "LAKOUR_LOUPS.Bailli.Personne"}}{{else if vote.resultat.egalite}}{{localize "LAKOUR_LOUPS.Vote.Egalite"}}{{else}}{{localize "LAKOUR_LOUPS.Journal.VoteNul"}}{{/if}}
          {{else if vote.resultat.bailli}}{{localize "LAKOUR_LOUPS.Bailli.EluCourt"}} <strong>{{vote.resultat.elus}}</strong>{{#if vote.resultat.sort}} <small>({{localize "LAKOUR_LOUPS.Bailli.ParLeSort"}})</small>{{/if}}
          {{else}}{{localize "LAKOUR_LOUPS.Vote.Designe"}} <strong>{{vote.resultat.elus}}</strong>{{/if}}
          {{#if vote.resultat.departage.choix}}<br><small><i class="fa-solid fa-stamp"></i> {{loupsT "LAKOUR_LOUPS.Bailli.TrancheCourt" nom=vote.resultat.departage.nom}}</small>{{/if}}
          {{#if vote.resultat.banc}}<br><small><i class="fa-solid fa-hand-point-right"></i> {{#if vote.resultat.banc.condamne}}{{loupsT "LAKOUR_LOUPS.Banc.Condamne" nom=vote.resultat.banc.nom pour=vote.resultat.banc.pour total=vote.resultat.banc.total}}{{else}}{{loupsT "LAKOUR_LOUPS.Banc.Acquitte" nom=vote.resultat.banc.nom pour=vote.resultat.banc.pour total=vote.resultat.banc.total}}{{/if}}</small>{{/if}}
          {{#if vote.resultat.deuil}}<br><small><i class="fa-solid fa-bell"></i> {{loupsT "LAKOUR_LOUPS.Deuil.Voix" nom=vote.resultat.deuil}}</small>{{/if}}
        </p>
        {{#if vote.resultat.departage.candidats.length}}
        <div class="loups-actions loups-trancher">
          <span class="loups-etiquette">{{loupsT "LAKOUR_LOUPS.Table.TrancherPour" nom=vote.resultat.departage.nom}}</span>
          {{#each vote.resultat.departage.candidats}}<button type="button" class="loups-bouton discret" data-action="trancher" data-id="{{id}}"><i class="fa-solid fa-stamp"></i> {{nom}}</button>{{/each}}
          <button type="button" class="loups-bouton discret" data-action="trancher" data-id="">{{localize "LAKOUR_LOUPS.Table.Personne"}}</button>
        </div>
        {{/if}}
        {{#if gm}}{{#each vote.resultat.condamnes}}
        <button type="button" class="loups-bouton" data-action="executer" data-id="{{id}}"><i class="fa-solid fa-gavel"></i> {{loupsT "LAKOUR_LOUPS.Etapes.executer" nom=nom}}</button>
        {{/each}}{{/if}}
      </section>
      {{/if}}

      <section class="loups-encart loups-registre">
        <h3><i class="fa-solid fa-book-bookmark"></i> {{localize "LAKOUR_LOUPS.Registre.Titre"}}</h3>
        {{#if declaration}}
        {{#if declaration.ok}}
        <div class="loups-declarer">
          <input type="text" name="declaration" maxlength="{{declaration.max}}" placeholder="{{localize 'LAKOUR_LOUPS.Registre.Exemple'}}" aria-label="{{localize 'LAKOUR_LOUPS.Registre.Declarer'}}">
          <button type="button" class="loups-bouton discret" data-action="declarer" data-tooltip="{{localize 'LAKOUR_LOUPS.Registre.DeclarerAide'}}"><i class="fa-solid fa-feather-pointed"></i> {{localize "LAKOUR_LOUPS.Registre.Declarer"}}</button>
        </div>
        {{else}}<p class="loups-vide"><small>{{declaration.raison}}</small></p>{{/if}}
        {{/if}}
        {{#if registre.length}}
        <ul class="loups-journal">{{#each registre}}<li class="registre-{{type}} {{#if annule}}annule{{/if}}"><i class="fa-solid {{icone}}"></i> {{texte}}</li>{{/each}}</ul>
        {{else}}<p class="loups-vide">{{localize "LAKOUR_LOUPS.Registre.Vide"}}</p>{{/if}}
      </section>

      <section class="loups-encart">
        <h3><i class="fa-solid fa-landmark"></i> {{localize "LAKOUR_LOUPS.Table.Batiments"}}</h3>
        {{#if batiments.length}}
        <ul class="loups-batiments">
          {{#each batiments}}
          <li data-action="batiment" data-uuid="{{uuid}}"><img src="{{img}}" alt=""><span>{{nom}}</span>{{#if repere}}<small>{{repere}}</small>{{/if}}</li>
          {{/each}}
        </ul>
        {{else}}<p class="loups-vide">{{localize "LAKOUR_LOUPS.Table.AucunBatiment"}}</p>{{/if}}
      </section>

      {{#if gm}}
      <section class="loups-encart loups-commandes">
        <h3><i class="fa-solid fa-hat-wizard"></i> {{localize "LAKOUR_LOUPS.Table.Narrateur"}}</h3>
        <div class="loups-phases">
          {{#each phases}}<button type="button" class="{{#if active}}actif{{/if}}" data-action="phase" data-phase="{{cle}}">{{libelle}}</button>{{/each}}
        </div>
        <div class="loups-actions">
          <button type="button" data-action="aube"><i class="fa-solid fa-sun"></i> {{localize "LAKOUR_LOUPS.Table.ResoudreAube"}}</button>
          {{#if vote.ouvert}}
          <button type="button" data-action="cloreVote"><i class="fa-solid fa-gavel"></i> {{localize "LAKOUR_LOUPS.Table.CloreVote"}}</button>
          {{else}}
          {{#if voteBailli}}<button type="button" data-action="voteBailli"><i class="fa-solid fa-stamp"></i> {{localize "LAKOUR_LOUPS.Table.VoteBailli"}}</button>{{/if}}
          {{#if nommerBailli}}<button type="button" data-action="nommerBailli"><i class="fa-solid fa-stamp"></i> {{localize "LAKOUR_LOUPS.Table.NommerBailli"}}</button>{{/if}}
          <button type="button" data-action="ouvrirVote"><i class="fa-solid fa-scale-balanced"></i> {{localize "LAKOUR_LOUPS.Table.OuvrirVote"}}</button>
          {{#if chapelle}}<button type="button" data-action="voteChapelle"><i class="fa-solid fa-church"></i> {{localize "LAKOUR_LOUPS.Table.VoteChapelle"}}</button>{{/if}}
          {{#if passage.exil}}<button type="button" data-action="voteExil"><i class="fa-solid fa-person-walking-arrow-right"></i> {{localize "LAKOUR_LOUPS.Passage.VoteExilBouton"}}</button>{{/if}}
          {{/if}}
          {{#if passage}}<button type="button" data-action="accueillir" {{#unless passage.accueil.ok}}disabled data-tooltip="{{passage.accueil.raisonTexte}}"{{/unless}}><i class="fa-solid fa-person-walking-luggage"></i> {{localize "LAKOUR_LOUPS.Passage.Accueillir"}}</button>{{/if}}
          <button type="button" data-action="victoire"><i class="fa-solid fa-crown"></i> {{localize "LAKOUR_LOUPS.Table.VerifierVictoire"}}</button>
          {{#if emporteur}}<button type="button" data-action="emporter" data-id="{{emporteur.id}}"><i class="fa-solid fa-person-falling"></i> {{loupsT "LAKOUR_LOUPS.Etapes.emporter" nom=emporteur.nom}}</button>
          <button type="button" data-action="emporterPersonne" data-id="{{emporteur.id}}">{{localize "LAKOUR_LOUPS.Table.Personne"}}</button>{{/if}}
          <button type="button" data-action="miseEnScene" title="{{localize 'LAKOUR_LOUPS.Table.MiseEnSceneAide'}}"><i class="fa-solid fa-chess-board"></i> {{localize "LAKOUR_LOUPS.Table.MiseEnScene"}}</button>
          {{#if saints}}
          <div class="loups-saints">
            {{#if saints.etoileOuverte}}
            <label data-tooltip="{{localize 'LAKOUR_LOUPS.Calendrier.EtoileAide'}}"><i class="fa-solid fa-star"></i> {{localize "LAKOUR_LOUPS.Calendrier.EtoileTitre"}}
              <select name="bonneEtoile"><option value="">—</option>{{#each saints.vivants}}<option value="{{id}}" {{#if choisi}}selected{{/if}}>{{nom}}</option>{{/each}}</select></label>
            <button type="button" class="loups-bouton discret" data-action="bonneEtoile">{{localize "LAKOUR_LOUPS.Calendrier.Poser"}}</button>
            {{/if}}
            <label data-tooltip="{{localize 'LAKOUR_LOUPS.Calendrier.GlasAide'}}"><i class="fa-solid fa-bell"></i> {{localize "LAKOUR_LOUPS.Calendrier.GlasTitre"}}
              <input type="number" name="glasFinal" min="0" max="30" step="1" value="{{glas}}"></label>
            <button type="button" class="loups-bouton discret" data-action="glasFinal">{{localize "LAKOUR_LOUPS.Calendrier.Poser"}}</button>
          </div>
          {{/if}}
          <button type="button" class="{{#if fini}}actif{{/if}}" data-action="rejouer"><i class="fa-solid fa-rotate-right"></i> {{localize "LAKOUR_LOUPS.Table.Rejouer"}}</button>
        </div>
      </section>

      {{#if nuit}}
      <section class="loups-encart">
        <h3><i class="fa-solid fa-moon"></i> {{localize "LAKOUR_LOUPS.Table.OrdreDeNuit"}}</h3>
        <ol class="loups-ordre">
          {{#each nuit.ordre}}<li class="{{#if fait}}fait{{/if}}"><code>{{roleCle}}</code> <span>{{noms}}</span>
            {{#unless fait}}{{#if enCours}}<span class="loups-pastille nuit"><i class="fa-solid fa-hourglass-half"></i> {{localize "LAKOUR_LOUPS.Table.EnAttente"}}</span>
            {{else}}<button type="button" class="loups-bouton discret" data-action="reveiller" data-role="{{roleCle}}"><i class="fa-solid fa-bell"></i> {{localize "LAKOUR_LOUPS.Table.Reveiller"}}</button>{{/if}}{{/unless}}
          </li>{{/each}}
        </ol>
        <button type="button" class="loups-bouton discret" data-action="reveillerTout"><i class="fa-solid fa-forward"></i> {{localize "LAKOUR_LOUPS.Table.ReveillerTout"}}</button>
        {{#if nuit.actions.length}}
        <h4>{{localize "LAKOUR_LOUPS.Table.ActionsNotees"}}</h4>
        <ul class="loups-journal">{{#each nuit.actions}}<li><strong>{{qui}}</strong> ({{roleCle}}{{#if effet}}, {{effet}}{{/if}}) → {{cibles}}</li>{{/each}}</ul>
        {{/if}}
      </section>
      {{/if}}

      {{#if historique.length}}
      <section class="loups-encart">
        <h3><i class="fa-solid fa-book-open"></i> {{localize "LAKOUR_LOUPS.Table.Chronique"}}</h3>
        <ul class="loups-journal">{{#each historique}}<li class="{{#if secret}}secret{{/if}}"><span class="loups-etiquette">{{#if secret}}<i class="fa-solid fa-lock"></i> {{/if}}{{tour}} · {{phase}}</span> {{texte}}</li>{{/each}}</ul>
      </section>
      {{/if}}
      {{/if}}
    </aside>
  </div>
</div>
